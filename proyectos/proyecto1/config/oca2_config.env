# Configuracion del pipeline EGFR FASTA
# Puede cambiar estos valores para analizar otra proteina o transcrito.

GENE_SYMBOL="OCA2"
ORGANISM="Homo sapiens"

# Proteina humana EGFR, UniProtKB/Swiss-Prot
UNIPROT_ACCESSION="Q04671"

# Transcrito humano EGFR de referencia. Sin version para obtener la version actual desde NCBI.
NCBI_NUCCORE_ID="NM_000275"

# Prefijos de salida
PROTEIN_PREFIX="OCA2_protein"
MRNA_PREFIX="OCA2_mRNA"
